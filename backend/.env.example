# Shared secrets for ALL backend services (gitignored — never commit).
# Copy real values from a teammate or your password manager.
# Each service adds only its own keys (PORT, HOST, …) in its own .env.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="paste-the-shared-secret-here"
URL_API_RENDER="https://your-render-service.onrender.com"
